# Обратный прокси перед Next. HTTPS-сертификат Caddy получает у Let's
# Encrypt сам — для этого A-запись домена уже должна указывать на сервер.
# {DOMAIN} подставляет deploy/setup.sh.

{DOMAIN} {
	encode zstd gzip

	# Заголовки безопасности. Content-Type и Referrer выставляет само
	# приложение (src/proxy.ts), здесь — то, что удобнее держать на краю.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Загруженные фото и статика Next живут долго: имя файла меняется
	# вместе с содержимым, так что кэшировать можно смело.
	@static path /_next/static/* /uploads/* /brand/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3000
}

# Один канонический адрес — без www. Второй хост отдаёт постоянный
# редирект, иначе поисковик увидит два сайта с одинаковыми страницами.
www.{DOMAIN} {
	redir https://{DOMAIN}{uri} permanent
}
