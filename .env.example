# ─── Основное ────────────────────────────────────────────────────────────────

# Секрет для подписи сессионных токенов. Минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Адрес сайта без завершающего слэша: канонические ссылки, sitemap,
# абсолютные адреса картинок в разметке.
# В продакшене переменная обязательна — сборка упадёт, если её нет.
# Домен пока не выбран, для разработки подойдёт localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Папка с базой. Пусто — data/ внутри проекта (так в разработке).
# На сервере база общая для всех версий и лежит отдельно: /srv/ugg/shared/data
DATA_DIR=


# ─── Доставка СДЭК ───────────────────────────────────────────────────────────

# Тестовый контур СДЭК — https://api.edu.cdek.ru
# Боевой — https://api.cdek.ru
CDEK_API_URL=https://api.edu.cdek.ru

# Учётные данные интеграции. Ниже — публичные тестовые ключи из документации
# СДЭК, чтобы проект запускался сразу. Для продакшена заменить на свои.
CDEK_ACCOUNT=wqGwiQx0gg8mLtiEKsUinjVSICCjtTEP
CDEK_PASSWORD=RmAmgvSgSl1yirlz9QupbzOJVqhCxcP5

# Откуда отправляются посылки. Это только запасные значения:
# рабочие настройки задаются в админке, в разделе «Логистика».
CDEK_FROM_CITY_CODE=44
CDEK_SHIPMENT_POINT=


# ─── Оплата ЮKassa ───────────────────────────────────────────────────────────

# Пока переменные пустые, оплата картой на сайте выключена — покупателю
# доступна только оплата при получении. Заполните — включится сама.
# Ключи выдаются в личном кабинете ЮKassa: Интеграция → Ключи API.
# Для проверки там же есть тестовый магазин со своей парой ключей.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Адрес вебхука для личного кабинета ЮKassa (Интеграция → HTTP-уведомления):
#   https://<ваш-сайт>/api/payments/yookassa
# События: payment.succeeded, payment.canceled, refund.succeeded.

# Чек по 54-ФЗ формирует ЮKassa, если в кабинете включены чеки.
# Ставка НДС в чеке: 1 — без НДС (ИП на УСН), 2 — 0 %, 3 — 10 %, 4 — 20 %.
YOOKASSA_VAT_CODE=1
# Поставьте 0, чтобы не передавать чек (если чеки выбивает своя касса).
YOOKASSA_RECEIPT=1


# ─── Почта сайта ─────────────────────────────────────────────────────────────

# Отправка писем: подтверждение почты при регистрации, уведомления о заказах.
# Пароль — «пароль приложения» из Яндекс ID (Безопасность → Пароли
# приложений → Почта), а не пароль от ящика. Пока пусто, регистрация
# проходит без подтверждения почты, письма не уходят.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# Только если хостинг закрыл исходящий SMTP по IPv4: подключаться сразу по IPv6.
# SMTP_IP_FAMILY=6
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="UGG <info@uggrussia.shop>"


# ─── Аналитика и подтверждение прав ──────────────────────────────────────────
# Эти значения можно задать и здесь, и в админке в разделе SEO.

NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=
