# ─── Основное ────────────────────────────────────────────────────────────────

# Секрет для подписи сессионных токенов. Минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Адрес сайта без завершающего слэша: канонические ссылки, sitemap,
# абсолютные адреса картинок в разметке.
# В продакшене переменная обязательна — сборка упадёт, если её нет.
# Домен пока не выбран, для разработки подойдёт localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── Доставка СДЭК ───────────────────────────────────────────────────────────

# Тестовый контур СДЭК — https://api.edu.cdek.ru
# Боевой — https://api.cdek.ru
CDEK_API_URL=https://api.edu.cdek.ru

# Учётные данные интеграции. Ниже — публичные тестовые ключи из документации
# СДЭК, чтобы проект запускался сразу. Для продакшена заменить на свои.
CDEK_ACCOUNT=wqGwiQx0gg8mLtiEKsUinjVSICCjtTEP
CDEK_PASSWORD=RmAmgvSgSl1yirlz9QupbzOJVqhCxcP5

# Откуда отправляются посылки. Это только запасные значения:
# рабочие настройки задаются в админке, в разделе «Логистика».
CDEK_FROM_CITY_CODE=44
CDEK_SHIPMENT_POINT=


# ─── Оплата ЮKassa ───────────────────────────────────────────────────────────

# Пока переменные пустые, онлайн-оплата выключена: заказ оформляется,
# оплата согласовывается с менеджером. Заполните — включится автоматически.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=


# ─── Аналитика и подтверждение прав ──────────────────────────────────────────
# Эти значения можно задать и здесь, и в админке в разделе SEO.

NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=
